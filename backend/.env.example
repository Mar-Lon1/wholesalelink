# WholesaleLink Backend Environment Variables (Production & Local)

# PostgreSQL Connection URL (Supabase Pooler recommended for serverless/hosted)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Auth Secret (generate a random 32+ char secret)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# Cookie Secret
COOKIE_SECRET="your-super-secret-cookie-key"

# Node Environment ('production' on Render)
NODE_ENV="production"

# Port (Render automatically sets this, defaults to 5001 locally)
PORT=5001

# Allowed Frontend URL(s) for CORS, comma-separated (e.g. your Vercel URL)
FRONTEND_URL="https://your-frontend.vercel.app,http://localhost:5173"
